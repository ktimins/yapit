<!-- This ClickHouse only exists because Stack Auth's migration runner requires it
     (github.com/stack-auth/stack-auth/issues/1228). Its default self-telemetry has no
     TTL and grows unbounded even when idle (~600MB/day; hit 97GB on prod 2026-07).
     Disable all introspection logs; keep query_log with a short TTL for debugging. -->
<clickhouse>
    <trace_log remove="remove"/>
    <metric_log remove="remove"/>
    <asynchronous_metric_log remove="remove"/>
    <text_log remove="remove"/>
    <processors_profile_log remove="remove"/>
    <part_log remove="remove"/>
    <asynchronous_insert_log remove="remove"/>
    <error_log remove="remove"/>
    <query_metric_log remove="remove"/>
    <query_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_log>
</clickhouse>
